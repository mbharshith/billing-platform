# =========================================================================
# Cashier API — environment configuration (Twelve-Factor per GUARDRAILS §12)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =========================================================================

# --- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- MongoDB ---------------------------------------------------------------
# Docker Compose default; override in prod.
MONGO_URI=mongodb://mongo:27017/cashier

# --- Auth ------------------------------------------------------------------
# CHANGE IN PRODUCTION. At least 32 chars, high entropy.
JWT_SECRET=change-me-please-and-make-it-long-random-and-uncommitted
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# --- CORS ------------------------------------------------------------------
# Comma-separated origins. Wildcard `*` forbidden in production (§6).
CORS_ORIGINS=http://localhost:4173,http://localhost:5173

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Sales -----------------------------------------------------------------
# Sales-tax rate applied to subtotals. Adjust per store locale.
TAX_RATE=0.0825

# --- Seed ------------------------------------------------------------------
# Credentials created by `npm run seed`. Change immediately after first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CASHIER_USERNAME=cashier1
SEED_CASHIER_PASSWORD=Cashier@123
