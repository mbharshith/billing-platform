  },
  "devDependencies": {
    "@types/react":     "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react":            "^18.3.1",
    "react-dom":        "^18.3.1",
    "react-router-dom": "^6.28.0",
    "dexie":            "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "typescript":       "^5.6.3"
  }
